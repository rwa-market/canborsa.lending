# /etc/lending/ledger-credentials.env on the backend host (root:root, 0600): per-role ledger accounts
# (audit I-6, B-1). systemd reads the file when lending-backend@* starts; CI does not see it.
# Client secrets live in separate files in /etc/lending/credentials/ (root:lending, 0640).
# Ledger roles are different users with minimal rights; one account for two roles fails startup.
#
# Each role has its own OIDC client (client credentials) at the validator identity provider and its own
# ledger user with rights only to its own party:
#   OPERATOR    CanActAs operator                     (bots accounts, absorber, merge, logins, API)
#   ORACLE      CanActAs oracle                       (oracle bot)
#   LIQUIDATOR  CanActAs liquidator, CanReadAs operator
#   BACKSTOP    CanActAs backstop, CanReadAs operator
#   READER      CanReadAs operator (ACS reads for the API and the indexer)
#   CUSTODY     CanActAs custody (deployment.json evm.custody), CanReadAs operator: EVM wallet
#               operations in the API, deposits and redeems bots (only REAL_ASSETS/ASSET_PROFILE=real)
# Guardian, treasury and council members are external parties with their own keys (human wallets); the backend
# does not sign for them, and there are no accounts for them here.

LEDGER_TOKEN_URL=https://auth.validator.example.com/realms/lending/protocol/openid-connect/token

LEDGER_OPERATOR_CLIENT_ID=lending-operator
LEDGER_OPERATOR_CLIENT_SECRET_FILE=/etc/lending/credentials/operator.secret
LEDGER_OPERATOR_USER_ID=lending-operator
#LEDGER_OPERATOR_AUDIENCE=https://canton.network.global
#LEDGER_OPERATOR_SCOPE=daml_ledger_api

LEDGER_ORACLE_CLIENT_ID=lending-oracle
LEDGER_ORACLE_CLIENT_SECRET_FILE=/etc/lending/credentials/oracle.secret
LEDGER_ORACLE_USER_ID=lending-oracle

LEDGER_LIQUIDATOR_CLIENT_ID=lending-liquidator
LEDGER_LIQUIDATOR_CLIENT_SECRET_FILE=/etc/lending/credentials/liquidator.secret
LEDGER_LIQUIDATOR_USER_ID=lending-liquidator

LEDGER_BACKSTOP_CLIENT_ID=lending-backstop
LEDGER_BACKSTOP_CLIENT_SECRET_FILE=/etc/lending/credentials/backstop.secret
LEDGER_BACKSTOP_USER_ID=lending-backstop

LEDGER_READER_CLIENT_ID=lending-reader
LEDGER_READER_CLIENT_SECRET_FILE=/etc/lending/credentials/reader.secret
LEDGER_READER_USER_ID=lending-reader

# Only with real assets (REAL_ASSETS=true, ASSET_PROFILE=real):
#LEDGER_CUSTODY_CLIENT_ID=lending-custody
#LEDGER_CUSTODY_CLIENT_SECRET_FILE=/etc/lending/credentials/custody.secret
#LEDGER_CUSTODY_USER_ID=lending-custody
