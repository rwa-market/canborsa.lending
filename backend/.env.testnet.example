# Backend on TestNet (real USDCx, CC, CBTC). No TEST_FAUCET or demo modes:
# with LEDGER_NETWORK=testnet the backend does not start with them. Processes can be split by role:
#   API + operator:  SERVE_API=true  BOTS=accounts,absorber,merge,logins,indexer
#   oracle:          SERVE_API=false BOTS=oracle,attestation (only LEDGER_ORACLE_* needed)
#   liquidator:      SERVE_API=false BOTS=liquidator (LEDGER_LIQUIDATOR_* and LEDGER_READER_*)
#   backstop:        SERVE_API=false BOTS=backstop (LEDGER_BACKSTOP_* and LEDGER_READER_*)
NODE_ENV=production
HOST=127.0.0.1
PORT=3001
LOG_LEVEL=info
# Logs for journald/a collector: JSON regardless of NODE_ENV
LOG_FORMAT=json
# Release commit: /health returns it, the deploy checks the slot (set by release.sh)
# RELEASE_SHA=
# Buyers of absorbed collateral: minimum to receive = quote × (1 − tolerance)
# BUY_TOLERANCE=0.02
LEDGER_NETWORK=testnet
LEDGER_API_URL=https://ledger-api.validator.example
DEPLOYMENT_PATH=./deployment.testnet.json
DATABASE_PATH=./data/lending-testnet.db
CORS_ORIGIN=https://lending.example
ALLOWED_HOSTS=lending.example
TRUSTED_PROXIES=127.0.0.1
AUTH_SECRET=__AUTH_SECRET__
NETWORK_ID=canton:testnet
# F-15: browser session in the httpOnly cookie lending_session. Non-GET requests by cookie are
# accepted only with X-Lending-Client: web and an Origin from CORS_ORIGIN or ALLOWED_HOSTS. Secure
# is set if nginx (from TRUSTED_PROXIES) passes X-Forwarded-Proto: https.
# D-7: command preparations per party per minute
COMMAND_RATE_PER_PARTY_PER_MINUTE=20
# SYNCHRONIZER_ID=global-domain::1220...

LEDGER_TOKEN_URL=https://keycloak.example/realms/validator/protocol/openid-connect/token
LEDGER_OPERATOR_CLIENT_ID=lending-operator
LEDGER_OPERATOR_CLIENT_SECRET_FILE=/etc/lending/secrets/operator
LEDGER_OPERATOR_USER_ID=lending-operator
LEDGER_LIQUIDATOR_CLIENT_ID=lending-liquidator
LEDGER_LIQUIDATOR_CLIENT_SECRET_FILE=/etc/lending/secrets/liquidator
LEDGER_LIQUIDATOR_USER_ID=lending-liquidator
LEDGER_BACKSTOP_CLIENT_ID=lending-backstop
LEDGER_BACKSTOP_CLIENT_SECRET_FILE=/etc/lending/secrets/backstop
LEDGER_BACKSTOP_USER_ID=lending-backstop

TOKEN_REGISTRY=http
TOKEN_REGISTRY_URLS={"usdcx":"https://usdcx-registry.example","cc":{"url":"https://validator.example/api/validator/v0/scan-proxy","auth":"ledger"},"cbtc":"https://cbtc-registry.example"}

SERVE_API=true
BOTS=accounts,absorber,merge,logins,indexer
BOTS_LEASE_FILE=./run/bots.lease
ORACLE_MODE=live
# B-7: USDCx has no public feed; without its own source USDCx is quoted as USDC.
# Own source: in ORACLE_HTTP_SOURCES and in ORACLE_SOURCES.usdcx:
# ORACLE_SOURCES={"usdcx":["xreserve","coingecko"],"cc":["coingecko","coinpaprika"],"cbtc":["coingecko","coinpaprika"]}
ORACLE_SOURCES=coingecko,coinpaprika
ORACLE_USDCX_DEPEG_BOUND=0.02
# N5: minimum backstop USDCx for /health/ready (process with LEDGER_BACKSTOP_*)
BACKSTOP_MIN_BALANCE=25000

# ---- TestNet real assets (ADR-005): CC (Amulet), USDCx (xReserve, Sepolia), CBTC.
# Without both flags: the test profile. deployment.json must contain exactly the network's
# instruments (otherwise startup fails), no eth/sol, and evm.custody.
# REAL_ASSETS=true
# ASSET_PROFILE=real
# EVM_WALLETS=true
# EVM wallet custodian: operations, deposits, withdrawals (deposits bot, redeems, API)
# LEDGER_CUSTODY_CLIENT_ID=lending-custody
# LEDGER_CUSTODY_CLIENT_SECRET_FILE=/etc/lending/secrets/custody
# LEDGER_CUSTODY_USER_ID=lending-custody
# Real asset bots (only with ASSET_PROFILE=real): BOTS=…,deposits,redeems
# DEPOSITS_INTERVAL_MS=15000
# REDEEMS_INTERVAL_MS=15000
# Registries come from the profile; TOKEN_REGISTRY_URLS overrides a slot (e.g. CC via
# own validator's scan-proxy with auth=ledger).
# Sepolia JSON-RPC for checking xReserve deposits (POST /evm/claim-deposit). A URL with a provider
# key is a secret. Without it claim is disabled and /config.realAssets.xreserve = null.
# ETH_RPC_URL=https://sepolia.example/v3/<key>
# ETH_RPC_TIMEOUT_MS=10000
# ETH_MIN_CONFIRMATIONS=12
# TODO: xReserve deposit event (not in Circle docs); without it: calldata + USDC Transfer
# XRESERVE_DEPOSIT_EVENT=event …
# TODO: xReserve fee is not published; a ceiling for the frontend, in USDC units
# XRESERVE_MAX_FEE=0
# DA Utilities backend (burn-mint-factory); defaults to the profile
# UTILITIES_BACKEND_URL=https://api.utilities.digitalasset-staging.com
# TODO: CC TransferPreapproval provider (assets:setup-cc), usually the validator operator party
# CC_PREAPPROVAL_PROVIDER=
# Keyed price sources (RedStone, Kaiko, Chainlink Data Streams): see backend/.env.example
# Readiness (/health/ready) thresholds of the absorb bots (Б6) and the collateral alert (risk 6):
# an absorbable or unpriced indebted account waiting longer than ABSORB_ALERT_MS, absorbed collateral
# unsold longer than STOCK_ALERT_MS (only while the sale is open), a market's user collateral worth
# more than COLLATERAL_ALERT_USD. MONITOR_INTERVAL_MS is the cycle of the absorber and the buyers.
# ABSORB_ALERT_MS=300000
# STOCK_ALERT_MS=1800000
# COLLATERAL_ALERT_USD=75000
# Net reserves (reserves + absorbed stock book value) below RESERVES_ALERT_USD, USDCx: 0 alerts only
# when they are negative (loans and deposit withdrawals closed); TestNet: the starting reserves
RESERVES_ALERT_USD=15000
# MONITOR_INTERVAL_MS=10000
# The backstop buys absorbed collateral that has waited this long, ms
# BACKSTOP_DELAY_MS=120000
