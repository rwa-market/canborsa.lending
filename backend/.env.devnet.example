# Backend against the shared HackCanton DevNet node (NODERS hackcanton-01).
# The .env.devnet file is produced by `python3 scripts/devnet.py env`; run:
#   node --env-file=.env.devnet --import tsx src/server.ts
HOST=127.0.0.1
LEDGER_NETWORK=devnet
# Required with ledger credentials, at least 32 characters: `devnet.py env` puts openssl rand -hex 32 here
AUTH_SECRET=__AUTH_SECRET__
ALLOWED_HOSTS=localhost:3001,127.0.0.1:3001,localhost:5173,127.0.0.1:5173
PORT=3001
LOG_LEVEL=info
LEDGER_API_URL=https://ledger-api-json.participant.hackcanton-01.devnet.naas.noders.services
LEDGER_USER_ID=__LEDGER_USER_ID__
LEDGER_TOKEN_URL=https://keycloak.naas.noders.services/realms/noders-appsfactory/protocol/openid-connect/token
LEDGER_CLIENT_ID=web-app-ui-hackcanton-01-devnet
LEDGER_REFRESH_TOKEN_FILE=../.local/devnet/tokens.json
DEPLOYMENT_PATH=./deployment.devnet.json
DATABASE_PATH=./data/lending-devnet.db
CORS_ORIGIN=http://localhost:5173
BOTS=oracle,accounts,absorber,liquidator,backstop,attestation,merge,logins,indexer
# Live prices (CoinGecko, CoinPaprika); test CBTC has no PoR source, so attestation is demo
ORACLE_MODE=live
ATTESTATION_MODE=demo
ORACLE_HEARTBEAT_MS=60000
# Protocol network: the node wallet and EVM wallet messages are bound to it
NETWORK_ID=canton:devnet
# Test token faucet for signed-in users (DevNet only)
TEST_FAUCET=true
# Readiness (/health/ready) thresholds of the absorb bots (Б6) and the collateral alert (risk 6):
# an absorbable or unpriced indebted account waiting longer than ABSORB_ALERT_MS, absorbed collateral
# unsold longer than STOCK_ALERT_MS (only while the sale is open), a market's user collateral worth
# more than COLLATERAL_ALERT_USD. MONITOR_INTERVAL_MS is the cycle of the absorber and the buyers.
# ABSORB_ALERT_MS=300000
# STOCK_ALERT_MS=1800000
# COLLATERAL_ALERT_USD=75000
# Net reserves (reserves + absorbed stock book value) below RESERVES_ALERT_USD, USDCx: 0 alerts only
# when they are negative (loans and deposit withdrawals closed); TestNet: the starting reserves
# RESERVES_ALERT_USD=0
# MONITOR_INTERVAL_MS=10000
# Buyers: minimum to receive = quote × (1 − BUY_TOLERANCE); the backstop buys stock older than
# BACKSTOP_DELAY_MS
# BUY_TOLERANCE=0.02
# BACKSTOP_DELAY_MS=120000
