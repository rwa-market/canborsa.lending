{
  "name": "@lending/backend",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch --env-file-if-exists=.env src/server.ts",
    "start": "node --env-file-if-exists=.env dist/server.js",
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:backup": "node --env-file-if-exists=.env dist/scripts/db-backup.js",
    "db:backup:dev": "tsx --env-file-if-exists=.env src/scripts/db-backup.ts",
    "gov": "node --env-file-if-exists=.env dist/scripts/governance.js",
    "gov:dev": "tsx --env-file-if-exists=.env src/scripts/governance.ts",
    "devnet:setup": "tsx --env-file-if-exists=.env src/scripts/devnet-setup.ts",
    "assets:setup-cc": "tsx --env-file-if-exists=.env src/scripts/assets-setup.ts cc",
    "assets:setup-xreserve": "tsx --env-file-if-exists=.env src/scripts/assets-setup.ts xreserve",
    "assets:setup-registry": "tsx --env-file-if-exists=.env src/scripts/assets-setup.ts registry",
    "devnet:scenario": "tsx --env-file-if-exists=.env.devnet src/scripts/devnet-scenario.ts"
  },
  "dependencies": {
    "@fastify/cors": "^11.0.0",
    "@fastify/rate-limit": "^10.3.0",
    "@lending/shared": "workspace:*",
    "better-sqlite3": "^13.0.0",
    "decimal.js": "^10.6.0",
    "drizzle-orm": "^0.45.0",
    "fastify": "^5.12.0",
    "viem": "^2.57.1",
    "zod": "^4.0.0"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.0",
    "@types/node": "^24.0.0",
    "drizzle-kit": "^0.31.0",
    "pino-pretty": "^13.0.0",
    "tsx": "^4.23.0",
    "vitest": "^5.0.0"
  }
}
