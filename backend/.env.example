# Copy to .env. Do not put secrets in git. For DevNet with a node credential: scripts/devnet.py env
# (backend/.env.devnet.example).
HOST=127.0.0.1
PORT=3001
LOG_LEVEL=info
# Log format: json | pretty; unset means pretty only in a terminal (independent of NODE_ENV)
# LOG_FORMAT=pretty
# Release commit for /health (set by the deploy)
# RELEASE_SHA=
# devnet | testnet | mainnet. On testnet/mainnet the faucet and demo modes are forbidden;
# separate role credentials, an http registry and AUTH_SECRET are required.
LEDGER_NETWORK=devnet
# Node JSON Ledger API
LEDGER_API_URL=https://ledger-api-json.participant.hackcanton-01.devnet.naas.noders.services
# Paged ACS: page size and max pages per request
LEDGER_PAGE_SIZE=500
LEDGER_MAX_PAGES=200
DEPLOYMENT_PATH=./deployment.json
DATABASE_PATH=./data/lending.db
# Frontend origins, comma-separated; unset means ALLOWED_HOSTS only
CORS_ORIGIN=http://localhost:5173,http://127.0.0.1:5173
ALLOWED_HOSTS=localhost:3001,127.0.0.1:3001,localhost:5173,127.0.0.1:5173
# Session signing secret, 32+ chars: openssl rand -hex 32. Required with ledger credentials.
# AUTH_SECRET=
SESSION_TTL_MS=7200000
RATE_LIMIT_PER_MINUTE=300
# D-7: command preparations (POST /commands, /treasury, /governance, /admin) per party per minute
COMMAND_RATE_PER_PARTY_PER_MINUTE=20
# X-Forwarded-For is accepted only from these addresses (nginx on the same host)
TRUSTED_PROXIES=127.0.0.1
READ_CACHE_MS=1500

# ---- Ledger credentials. No role: the default credential (DevNet: one for all node parties).
# LEDGER_TOKEN=
# LEDGER_USER_ID=lending-backend
# LEDGER_TOKEN_URL=https://keycloak.example/realms/x/protocol/openid-connect/token
# On testnet/mainnet: a separate credential for each role the process uses
# (OPERATOR, ORACLE, LIQUIDATOR, BACKSTOP; READER is read-only on behalf of the operator):
# LEDGER_OPERATOR_CLIENT_ID=lending-operator
# LEDGER_OPERATOR_CLIENT_SECRET_FILE=/etc/lending/secrets/operator
# LEDGER_OPERATOR_USER_ID=lending-operator
# LEDGER_ORACLE_CLIENT_ID=lending-oracle
# LEDGER_ORACLE_CLIENT_SECRET_FILE=/etc/lending/secrets/oracle
# LEDGER_ORACLE_USER_ID=lending-oracle

# ---- Token Standard registries. ledger: test TokenRules of own node; http: Registry API (CIP-0056)
# TOKEN_REGISTRY=http
# TOKEN_REGISTRY_URLS={"usdcx":"https://usdcx-registry.example","cc":{"url":"https://validator.example/api/validator/v0/scan-proxy","auth":"ledger"},"cbtc":"https://cbtc-registry.example"}

# ---- Bots in this process. attestation in live mode requires RESERVE_ATTESTATION_URL.
SERVE_API=true
BOTS=oracle,accounts,absorber,liquidator,backstop,merge,logins,indexer
ORACLE_MODE=live
# A list applies to all instruments. JSON keyed by InstrumentId slot (usdcx, cc, cbtc): own sources
# per instrument (B-7). There is no public USDCx feed: coingecko/coinpaprika quote USDC, so a USDCx
# depeg from USDC is not visible this way (metric oracle_usdcx_proxy_source = 1). A USDCx source
# is plugged in via ORACLE_HTTP_SOURCES and its name in ORACLE_SOURCES.usdcx:
# ORACLE_SOURCES={"usdcx":["xreserve","coingecko"],"cc":["coingecko","coinpaprika"],"cbtc":["coingecko","coinpaprika"]}
# coinpaprika is also available, but the free quota runs out within hours (HTTP 402)
ORACLE_SOURCES=coingecko,kucoin,binance,bybit
# USDCx median further than this fraction from 1: error in the log and oracle_usdcx_depeg = 1 (the
# price is still published; the contract closes borrowing on depeg via maxDebtDepeg)
ORACLE_USDCX_DEPEG_BOUND=0.02
ORACLE_MIN_SOURCES=2
ORACLE_PUBLISH_DEVIATION=0.005
ORACLE_HEARTBEAT_MS=240000
# With enough agreeing quotes, older ones are left out of a publish (the feed is as old as its oldest)
ORACLE_FRESH_QUOTE_MS=120000
ORACLE_MAX_STEP=0.2
ORACLE_STEP_CONFIRMATIONS=3
# RESERVE_ATTESTATION_URL=https://por.example/cbtc
# N5: /health/ready is not ready if backstop has less USDCx (process with LEDGER_BACKSTOP_*)
BACKSTOP_MIN_BALANCE=25000

# Buyers of absorbed collateral: minimum to receive = quote × (1 − tolerance); the backstop
# buys stock that waited this long, ms
BUY_TOLERANCE=0.02
BACKSTOP_DELAY_MS=120000

# ---- EVM wallet sign-in (0.5.0, ADR-004). Off by default: users sign in only with
# Loop (ADR-006). false: no /auth/evm/*, /evm/*, /config.evm; the faucet does not pay EVM addresses.
# EVM_WALLETS=false

# ---- Real assets (ADR-005). Off by default: DevNet works as before.
# REAL_ASSETS=true and ASSET_PROFILE=real: only together and only on testnet/mainnet, otherwise
# the backend does not start. The profile supplies the network's InstrumentId, admin parties and
# registries for CC (Amulet), USDCx (DA Utilities), CBTC (BitSafe); no ETH or SOL. Requires the
# custodian credential LEDGER_CUSTODY_* (deployment.json evm.custody) and EVM_WALLETS=true. Example:
# backend/.env.testnet.example.
# REAL_ASSETS=false
# ASSET_PROFILE=test

# ---- Keyed price sources: enabled by name in ORACLE_SOURCES; a name without a key fails startup.
# Keys are secrets (BACKEND_ENV_SECRETS on deploy); do not put them in git.
# REDSTONE_API_KEY=
# REDSTONE_API_URL=https://api.redstone.finance
# REDSTONE_IDS={"usdcx":"USDC","cc":"CC","cbtc":"BTC"}
# KAIKO_API_KEY=
# KAIKO_API_URL=https://us.market-api.kaiko.io
# KAIKO_IDS={"usdcx":"usdc","cc":"cc","cbtc":"btc"}
# CHAINLINK_STREAMS_API_KEY=
# CHAINLINK_STREAMS_API_SECRET=
# CHAINLINK_STREAMS_URL=https://api.dataengine.chain.link
# CHAINLINK_FEED_IDS={"cbtc":"0x…"}   TODO: feedID is issued by Chainlink
# Readiness (/health/ready) thresholds of the absorb bots (Б6) and the collateral alert (risk 6):
# an absorbable or unpriced indebted account waiting longer than ABSORB_ALERT_MS, absorbed collateral
# unsold longer than STOCK_ALERT_MS (only while the sale is open), a market's user collateral worth
# more than COLLATERAL_ALERT_USD. MONITOR_INTERVAL_MS is the cycle of the absorber and the buyers.
# ABSORB_ALERT_MS=300000
# STOCK_ALERT_MS=1800000
# COLLATERAL_ALERT_USD=75000
# MONITOR_INTERVAL_MS=10000
