-- | Test environment: parties, three tokens on splice-test-token-v1, config, pool, prices, accounts.
module Test.Lending.Env where

import DA.Action (unless)
import DA.Foldable (forA_)
import DA.Map qualified as Map
import DA.Set qualified as Set
import Daml.Script

import Splice.Api.Token.HoldingV1 qualified as H
import Splice.Api.Token.MetadataV1 (ExtraArgs (..), emptyChoiceContext, emptyMetadata)
import Splice.Api.Token.TransferInstructionV1 (TransferFactory)
import Splice.Testing.Tokens.TestTokenV1 (Token (..), TokenRules (..))

import Lending.Account
import Lending.Config
import Lending.Math
import Lending.Oracle
import Lending.Pause
import Lending.Pool
import Lending.Rates
import Lending.Token
import Lending.Types
import Test.Lending.MockRewards (MockFeaturedAppRight)

data Env = Env
  with
    operator : Party
    oracle : Party
    guardian : Party
    treasury : Party
    backstop : Party
    liquidator : Party
    alice : Party
    bob : Party
    carol : Party
    testers : [Party]
      -- ^ test accounts for manual and e2e runs; only Deploy creates them
    council : [Party]
      -- ^ council members CouncilMember1..3; only Deploy fills this in
    usdcx : H.InstrumentId
    cc : H.InstrumentId
    cbtc : H.InstrumentId

-- | Pool with CC and CBTC markets, prices CC $0.20, BTC $100 000, USDCx $1.00.
-- Alice: 100 000 USDCx. Bob: 20 000 CC, 1 CBTC, 1 000 USDCx. Carol: 50 000 CC.
setup : Script Env
setup = setupNamed ""

-- | Same environment with a prefix in party names: several environments on one ledger.
setupNamed : Text -> Script Env
setupNamed prefix = setupWith (\name -> Daml.Script.allocateParty (prefix <> name))

-- | Environment with a given party source: allocate (tests) or take existing ones
-- (DevNet, where parties are created in the node console).
setupWith : (Text -> Script Party) -> Script Env
setupWith allocateParty = do
  operator <- allocateParty "Operator"
  oracle <- allocateParty "Oracle"
  guardian <- allocateParty "Guardian"
  treasury <- allocateParty "Treasury"
  backstop <- allocateParty "Backstop"
  liquidator <- allocateParty "Liquidator"
  alice <- allocateParty "Alice"
  bob <- allocateParty "Bob"
  carol <- allocateParty "Carol"
  usdcAdmin <- allocateParty "UsdcxRegistry"
  ccAdmin <- allocateParty "CcRegistry"
  cbtcAdmin <- allocateParty "CbtcRegistry"
  let testers = []
      council = []
  let usdcx = H.InstrumentId with admin = usdcAdmin; id = "USDCx"
      cc = H.InstrumentId with admin = ccAdmin; id = "CC"
      cbtc = H.InstrumentId with admin = cbtcAdmin; id = "CBTC"
      env = Env with ..
  -- a redeploy on DevNet reuses the registries' TokenRules: the test tokens stay where they are
  factories <- forA [usdcx, cc, cbtc] \i -> do
    existing <- query @TokenRules i.admin
    rules <- case existing of
      (cid, _) :: _ -> pure cid
      [] -> submit i.admin (createCmd TokenRules with admin = i.admin)
    pure (i, toInterfaceContractId @TransferFactory rules)
  now <- getTime
  _ <- submit operator $ createCmd ProtocolConfig with
    roles = Roles with
      operator; oracle; guardian; treasury; backstop
      liquidators = [liquidator]
    governors = []
    params = defaultProtocolParams usdcx
    marketParams = Map.fromList [("CC", ccMarketParams cc), ("CBTC", cbtcMarketParams cbtc)]
    transferFactories = Map.fromList factories
    featuredAppRight = None
    dso = None
  _ <- submit operator $ createCmd Pool with
    operator
    governors = []
    markets = Map.fromList [("CC", newMarket), ("CBTC", newMarket)]
    state = newPoolState now
  _ <- submit operator $ createCmd PauseState with operator; guardian; flags = noPause
  _ <- submit operator $ createCmd AccountDirectory with operator; holders = Set.empty
  forA_ [(usdcx, 1.0), (cc, 0.2), (cbtc, 100000.0)] \(instrumentId, price) ->
    submit oracle $ createCmd PriceFeed with
      oracle; instrumentId
      quotes = [PriceQuote "source-a" price now, PriceQuote "source-b" price now]
      observers = [operator]
  _ <- submit oracle $ createCmd ReserveAttestation with
    oracle; instrumentId = cbtc; coverage = 1.0; attestedAt = now; observers = [operator]
  mint env usdcx alice 100000.0
  mint env cc bob 20000.0
  mint env cbtc bob 1.0
  mint env usdcx bob 1000.0
  mint env cc carol 50000.0
  forA_ [alice, bob, carol] (openAccount env)
  pure env

-- Tokens ----------------------------------------------------------------------

mint : Env -> H.InstrumentId -> Party -> Decimal -> Script ()
mint _ instrumentId owner amount = do
  _ <- submit (actAs [instrumentId.admin, owner]) $ createCmd Token with
    holding = H.HoldingView with
      owner; instrumentId; amount; lock = None; meta = emptyMetadata
  pure ()

holdingsOf : Party -> H.InstrumentId -> Script [(ContractId H.Holding, H.HoldingView)]
holdingsOf party instrumentId = do
  hs <- queryInterface @H.Holding party
  pure [ (cid, v) | (cid, Some v) <- hs, v.owner == party, v.instrumentId == instrumentId, v.lock == None ]

balanceOf : Party -> H.InstrumentId -> Script Decimal
balanceOf party instrumentId = sum . map (.amount) . map snd <$> holdingsOf party instrumentId

rulesFor : H.InstrumentId -> Script (ContractId TokenRules)
rulesFor instrumentId = do
  rules <- query @TokenRules instrumentId.admin
  case rules of
    [(cid, _)] -> pure cid
    _ -> abort "expected exactly one TokenRules per registry"

noExtraArgs : ExtraArgs
noExtraArgs = ExtraArgs with context = emptyChoiceContext; meta = emptyMetadata

-- | Transfer arguments: all free holdings of the sender and the trusted factory.
transferArgs : Party -> H.InstrumentId -> Script TransferArgs
transferArgs sender instrumentId = do
  rules <- rulesFor instrumentId
  holdings <- holdingsOf sender instrumentId
  pure TransferArgs with
    factoryCid = toInterfaceContractId @TransferFactory rules
    inputHoldingCids = map fst holdings
    transferExtraArgs = noExtraArgs
    acceptExtraArgs = noExtraArgs

-- Protocol state --------------------------------------------------------------------

currentConfig : Env -> Script (ContractId ProtocolConfig, ProtocolConfig)
currentConfig env = do
  configs <- query @ProtocolConfig env.operator
  case configs of
    [c] -> pure c
    _ -> abort "expected exactly one ProtocolConfig"

currentPool : Env -> Script (ContractId Pool, Pool)
currentPool env = do
  pools <- query @Pool env.operator
  case pools of
    [p] -> pure p
    _ -> abort "expected exactly one Pool"

currentPause : Env -> Script (ContractId PauseState, PauseState)
currentPause env = do
  ps <- query @PauseState env.operator
  case ps of
    [p] -> pure p
    _ -> abort "expected exactly one PauseState"

currentDirectory : Env -> Script (ContractId AccountDirectory)
currentDirectory env = do
  ds <- query @AccountDirectory env.operator
  case ds of
    [(cid, _)] -> pure cid
    _ -> abort "expected exactly one AccountDirectory"

accountOf : Env -> Party -> Script (ContractId Account, Account)
accountOf env user = do
  accounts <- queryFilter @Account env.operator (\a -> a.owner == user)
  case accounts of
    [a] -> pure a
    _ -> abort "expected exactly one Account"

feedFor : Env -> H.InstrumentId -> Script (ContractId PriceFeed)
feedFor env instrumentId = do
  feeds <- queryFilter @PriceFeed env.oracle (\f -> f.instrumentId == instrumentId)
  case feeds of
    [(cid, _)] -> pure cid
    _ -> abort "expected exactly one PriceFeed per instrument"

attestationFor : Env -> H.InstrumentId -> Script (ContractId ReserveAttestation)
attestationFor env instrumentId = do
  atts <- queryFilter @ReserveAttestation env.oracle (\a -> a.instrumentId == instrumentId)
  case atts of
    [(cid, _)] -> pure cid
    _ -> abort "expected exactly one ReserveAttestation"

marketOf : Env -> MarketId -> Script Market
marketOf env marketId = do
  (_, pool) <- currentPool env
  case Map.lookup marketId pool.markets of
    Some m -> pure m
    None -> abort "unknown market"

marketParamsFor : Env -> MarketId -> Script MarketParams
marketParamsFor env marketId = do
  (_, config) <- currentConfig env
  case Map.lookup marketId config.marketParams of
    Some m -> pure m
    None -> abort "unknown market"

-- | Account balance in USDCx now (positive: deposit, negative: debt), after accrual to the pool's
-- last update. Tests run at frozen ledger time, so it is exact.
balanceFor : Env -> Party -> Script N
balanceFor env user = do
  (_, pool) <- currentPool env
  (_, account) <- accountOf env user
  pure (presentValue pool.state account.principal)

collateralFor : Env -> Party -> MarketId -> Script N
collateralFor env user marketId = collateralOf marketId . snd <$> accountOf env user

poolState : Env -> Script PoolState
poolState env = (.state) . snd <$> currentPool env

poolReserves : Env -> Script N
poolReserves env = reserves <$> poolState env

poolNetReserves : Env -> Script N
poolNetReserves env = do
  (_, pool) <- currentPool env
  pure (netReserves pool.state pool.markets)

-- | Prices from both sources.
setPrices : Env -> H.InstrumentId -> N -> N -> Script ()
setPrices env instrumentId a b = do
  cid <- feedFor env instrumentId
  now <- getTime
  _ <- submit env.oracle $ exerciseCmd cid PriceFeed_Update with
    newQuotes = [PriceQuote "source-a" a now, PriceQuote "source-b" b now]
  pure ()

setPrice : Env -> H.InstrumentId -> N -> Script ()
setPrice env instrumentId p = setPrices env instrumentId p p

-- | Refresh quote time without changing prices.
refreshPrices : Env -> Script ()
refreshPrices env = forA_ [env.usdcx, env.cc, env.cbtc] \i -> refreshPrice env i

refreshPrice : Env -> H.InstrumentId -> Script ()
refreshPrice env i = do
  cid <- feedFor env i
  Some feed <- queryContractId env.oracle cid
  now <- getTime
  _ <- submit env.oracle $ exerciseCmd cid PriceFeed_Update with
    newQuotes = map (\q -> q with observedAt = now) feed.quotes
  pure ()

-- Submitting commands as the user -------------------------------------------------

-- | Contracts the user gets from the backend via disclosure (T3.1.2).
disclosures : Env -> Script [Disclosure]
disclosures env = do
  (configCid, _) <- currentConfig env
  config <- queryDisclosure env.operator configCid
  (poolCid, _) <- currentPool env
  pool <- queryDisclosure env.operator poolCid
  (pauseCid, _) <- currentPause env
  pause <- queryDisclosure env.operator pauseCid
  rules <- forA [env.usdcx, env.cc, env.cbtc] \i -> rulesFor i >>= queryDisclosure i.admin
  feedCids <- queryFilter @PriceFeed env.oracle (const True)
  feeds <- forA feedCids \(cid, _) -> queryDisclosure env.oracle cid
  atts <- query @ReserveAttestation env.oracle
  attDs <- forA atts \(cid, _) -> queryDisclosure env.oracle cid
  (_, cfg) <- currentConfig env
  right <- case cfg.featuredAppRight of
    None -> pure None
    Some cid -> queryDisclosure env.operator (fromInterfaceContractId @MockFeaturedAppRight cid)
  opHoldings <- queryInterface @H.Holding env.operator
  held <- forA [ cid | (cid, Some v) <- opHoldings, v.owner == env.operator, v.lock == None ] \cid ->
    queryDisclosure env.operator (fromInterfaceContractId @Token cid)
  pure [ d | Some d <- config :: pool :: pause :: right :: rules <> feeds <> attDs <> held ]

-- | Submit a command on behalf of the user with disclosure, as the frontend will.
asUser : Env -> Party -> Commands a -> Script a
asUser env user cmds = do
  ds <- disclosures env
  submit (actAs user <> discloseMany ds) cmds

asUserMustFail : Env -> Party -> Commands a -> Script ()
asUserMustFail env user cmds = do
  ds <- disclosures env
  submitMustFail (actAs user <> discloseMany ds) cmds

-- | User request and account opening by the operator (accounts bot on the backend).
openAccount : Env -> Party -> Script ()
openAccount env user = do
  requestCid <- submit user $ createCmd AccountRequest with operator = env.operator; user
  directoryCid <- currentDirectory env
  _ <- submit env.operator $ exerciseCmd directoryCid Directory_Open with requestCid
  pure ()

-- Protocol commands ------------------------------------------------------------

type PoolCmd = Commands (ContractId Pool, ContractId Account)

marketInstrument : Env -> MarketId -> H.InstrumentId
marketInstrument env marketId = if marketId == "CC" then env.cc else env.cbtc

-- | Every collateral feed, the USDCx feed and the CBTC attestation: what the backend passes.
allPrices : Env -> Script PriceArgs
allPrices env = do
  cc <- feedFor env env.cc
  cbtc <- feedFor env env.cbtc
  usdcx <- feedFor env env.usdcx
  atts <- query @ReserveAttestation env.oracle
  pure PriceArgs with
    collateralFeedCids = [cc, cbtc]
    debtFeedCid = Some usdcx
    attestationCids = map fst atts

supplyCmdWith : Env -> Party -> Decimal -> Bool -> Script PoolCmd
supplyCmdWith env user amount full = do
  (configCid, _) <- currentConfig env
  (poolCid, _) <- currentPool env
  (accountCid, _) <- accountOf env user
  payment <- transferArgs user env.usdcx
  pure $ exerciseCmd poolCid Pool_SupplyBase with user; configCid; accountCid; amount; full; payment

-- | Supply USDCx: repays the debt first.
supplyCmd : Env -> Party -> Decimal -> Script PoolCmd
supplyCmd env user amount = supplyCmdWith env user amount False

-- | Repay the whole debt, paying at most `cap`.
repayAllCmd : Env -> Party -> Decimal -> Script PoolCmd
repayAllCmd env user cap = supplyCmdWith env user cap True

withdrawBaseCmd : Env -> Party -> Decimal -> Bool -> Bool -> PriceArgs -> Script PoolCmd
withdrawBaseCmd env user amount full allowBorrow prices = do
  (configCid, _) <- currentConfig env
  (poolCid, _) <- currentPool env
  (pauseCid, _) <- currentPause env
  (accountCid, _) <- accountOf env user
  payout <- transferArgs env.operator env.usdcx
  pure $ exerciseCmd poolCid Pool_WithdrawBase with
    user; configCid; pauseCid; accountCid; amount; full; allowBorrow; prices; payout

-- | Withdraw from the deposit, never borrowing.
withdrawCmd : Env -> Party -> Decimal -> Script PoolCmd
withdrawCmd env user amount = withdrawBaseCmd env user amount False False noPrices

withdrawAllCmd : Env -> Party -> Script PoolCmd
withdrawAllCmd env user = withdrawBaseCmd env user 1.0 True False noPrices

-- | Borrow: withdraw with borrowing allowed and every price.
borrowCmd : Env -> Party -> Decimal -> Script PoolCmd
borrowCmd env user amount = do
  prices <- allPrices env
  withdrawBaseCmd env user amount False True prices

depositCmd : Env -> Party -> MarketId -> Decimal -> Script PoolCmd
depositCmd env user marketId amount = do
  (configCid, _) <- currentConfig env
  (poolCid, _) <- currentPool env
  (accountCid, _) <- accountOf env user
  payment <- transferArgs user (marketInstrument env marketId)
  pure $ exerciseCmd poolCid Pool_SupplyCollateral with user; configCid; accountCid; marketId; amount; payment

withdrawCollateralCmdWith : Env -> Party -> MarketId -> Decimal -> PriceArgs -> Script PoolCmd
withdrawCollateralCmdWith env user marketId amount prices = do
  (configCid, _) <- currentConfig env
  (poolCid, _) <- currentPool env
  (pauseCid, _) <- currentPause env
  (accountCid, _) <- accountOf env user
  payout <- transferArgs env.operator (marketInstrument env marketId)
  pure $ exerciseCmd poolCid Pool_WithdrawCollateral with
    user; configCid; pauseCid; accountCid; marketId; amount; prices; payout

withdrawCollateralCmd : Env -> Party -> MarketId -> Decimal -> Script PoolCmd
withdrawCollateralCmd env user marketId amount = do
  prices <- allPrices env
  withdrawCollateralCmdWith env user marketId amount prices

-- | Run and expect success / failure.
run : Env -> Party -> Script (Commands a) -> Script ()
run env user mk = do
  cmd <- mk
  _ <- asUser env user cmd
  pure ()

mustFail : Env -> Party -> Script (Commands a) -> Script ()
mustFail env user mk = do
  cmd <- mk
  asUserMustFail env user cmd

-- Absorb and collateral sale --------------------------------------------------------

absorbCmdWith : Env -> Party -> PriceArgs -> Script (Commands (ContractId Pool, ContractId Account))
absorbCmdWith env user prices = do
  (configCid, _) <- currentConfig env
  (poolCid, _) <- currentPool env
  (pauseCid, _) <- currentPause env
  (accountCid, _) <- accountOf env user
  pure $ exerciseCmd poolCid Pool_Absorb with configCid; pauseCid; accountCid; prices

absorb : Env -> Party -> Script ()
absorb env user = do
  prices <- allPrices env
  cmd <- absorbCmdWith env user prices
  _ <- submit env.operator cmd
  pure ()

absorbMustFail : Env -> Party -> Script ()
absorbMustFail env user = do
  prices <- allPrices env
  cmd <- absorbCmdWith env user prices
  submitMustFail env.operator cmd

buyCmd : Env -> Party -> MarketId -> Decimal -> Decimal -> Script (Commands (ContractId Pool, Decimal))
buyCmd env buyer marketId amount minCollateral = do
  (configCid, _) <- currentConfig env
  (poolCid, _) <- currentPool env
  (pauseCid, _) <- currentPause env
  let instrument = marketInstrument env marketId
  collateralFeedCid <- feedFor env instrument
  debtFeedCid <- feedFor env env.usdcx
  payment <- transferArgs buyer env.usdcx
  payout <- transferArgs env.operator instrument
  pure $ exerciseCmd poolCid Pool_BuyCollateral with
    buyer; configCid; pauseCid; marketId; amount; minCollateral; collateralFeedCid; debtFeedCid; payment; payout

-- Administration --------------------------------------------------------------------

setPauseFlags : Env -> (PauseFlags -> PauseFlags) -> Script ()
setPauseFlags env f = do
  (cid, p) <- currentPause env
  _ <- submit env.guardian $ exerciseCmd cid PauseState_Set with newFlags = f p.flags
  pure ()

-- | Treasury adds USDCx reserves (minted to it first).
addReserves : Env -> Decimal -> Script ()
addReserves env amount = do
  mint env env.usdcx env.treasury amount
  (configCid, _) <- currentConfig env
  (poolCid, _) <- currentPool env
  payment <- transferArgs env.treasury env.usdcx
  _ <- asUser env env.treasury $ exerciseCmd poolCid Pool_AddReserves with
    actor = env.treasury; configCid; amount; payment
  pure ()

-- | Change protocol or market parameters (without the council: by the operator).
updateParams : Env -> (ProtocolParams -> ProtocolParams) -> [(MarketId, MarketParams -> MarketParams)] -> Script ()
updateParams env f fs = do
  (configCid, config) <- currentConfig env
  let marketParams = foldl
        (\acc (k, g) -> Map.alter (fmap g) k acc)
        config.marketParams fs
  _ <- submit env.operator $ exerciseCmd configCid Config_Update with
    newParams = f config.params
    newMarketParams = marketParams
    newTransferFactories = None
    newFeaturedAppRight = None
    newRoles = None
  pure ()

-- | Alice's supply so that the pool has liquidity.
seedLiquidity : Env -> Decimal -> Script ()
seedLiquidity env amount = run env env.alice (supplyCmd env env.alice amount)

-- Checks ----------------------------------------------------------------------

approxEq : Text -> N -> N -> N -> Script ()
approxEq label tolerance expected actual =
  unless (absN (expected - actual) <= tolerance) $
    abort (label <> ": expected " <> show expected <> ", got " <> show actual)

eqD : Text -> Decimal -> Decimal -> Script ()
eqD label expected actual =
  unless (expected == actual) $
    abort (label <> ": expected " <> show expected <> ", got " <> show actual)
